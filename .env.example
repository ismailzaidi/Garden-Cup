# Copy to .env.local for local dev (used by `vite dev` / `vercel dev`), and
# set the same key in Vercel's project settings (Production, Preview, and
# Development each have their own).
#
# Leave this unset/empty to run Garden Cup in local-only mode: no accounts,
# no API calls, data stays in this browser's localStorage, and the app's
# Export/Import buttons are the only way to move data between devices.
#
# Set it to /api once the backend is deployed (api/ is on the same Vercel
# deployment as the SPA, so this is a same-origin relative path, not a
# separate host).
VITE_API_BASE_URL=

# ---- server-side only (read by api/*, never exposed to the browser) ----
# These are NOT read by Vite — they belong in Vercel's project environment
# variables (or a local .env.local for `vercel dev`), never prefixed with
# VITE_. See api/README.md for the full list and what each one does:
# DB_HOST, DB_PORT, DB_USER, DB_PASS, DB_NAME, DB_SSL,
# DB_SSL_REJECT_UNAUTHORIZED, DB_POOL_SIZE, TOKEN_TTL_DAYS,
# SIGNUP_INVITE_CODE.
